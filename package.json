{
  "name": "dsh-balance-widget-fx",
  "version": "0.6.4",
  "description": "Balance & cost widget for DeepSeek Harness with multi-currency amounts (CNY/USD/RUB), Russian number formatting and a live USD-based FX feed. A fork of dsh-balance-widget 0.6.4 (MIT).",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh": ">=0.1.2-rc.1 <0.3.0"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "plugin",
    "balance",
    "cost",
    "multicurrency",
    "fx",
    "rub",
    "cny"
  ],
  "license": "MIT",
  "author": "Alex Kuznetsov (Skyfish)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skyfishitstudio/dsh-balance-widget-fx.git"
  },
  "bugs": {
    "url": "https://github.com/skyfishitstudio/dsh-balance-widget-fx/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
